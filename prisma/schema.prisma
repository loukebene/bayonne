datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  orderIndex Int      @default(0)
  dishes     Dish[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Dish {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String
  price           Int
  isVariablePrice Boolean  @default(false)
  priceNote       String?
  imageUrl        String
  isAvailable     Boolean  @default(true)
  isPopular       Boolean  @default(false)
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerName  String
  customerPhone String
  deliveryType  String      // SUR_PLACE, EMPORTER, LIVRAISON
  address       String?
  deliveryFee   Int         @default(0)
  subtotal      Int
  total         Int
  status        String      @default("NOUVELLE") // NOUVELLE, CONFIRMEE, EN_PREPARATION, PRETE, LIVREE, TERMINEE, ANNULEE
  notes         String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dishId     String?
  dishName   String
  unitPrice  Int
  quantity   Int
  totalPrice Int
}

model Reservation {
  id            String   @id @default(uuid())
  resNumber     String   @unique
  customerName  String
  customerPhone String
  date          String
  timeSlot      String
  guestCount    Int
  comment       String?
  status        String   @default("EN_ATTENTE") // EN_ATTENTE, CONFIRMEE, ANNULEE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CateringQuote {
  id              String   @id @default(uuid())
  quoteNumber     String   @unique
  customerName    String
  customerPhone   String
  eventType       String   // Mariage, Anniversaire, Repas d'entreprise, Réception, Événement privé
  eventDate       String
  guestCount      Int
  estimatedBudget Int      @default(0)
  message         String?
  status          String   @default("NOUVEAU") // NOUVEAU, CONTACTE, DEVIS_ENVOYE, VALIDE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
